# Copy this file to ".env" and fill in the values.

# Which AI recognizes the food: gemini or claude.
# If unset: Gemini when GEMINI_API_KEY is filled in, otherwise Claude.
AI_PROVIDER=gemini

# Gemini API key (https://aistudio.google.com/apikey). Free tier available.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Claude API key (https://console.anthropic.com), only needed if AI_PROVIDER=claude.
# Never put any key in the app itself.
ANTHROPIC_API_KEY=

# One-time code typed on the phone the first time the app opens.
# Make it long and random, e.g. 6 words or 20+ characters.
ENROLL_CODE=change-me-to-something-long

# How many phones may be registered (your father's phone + one for you to test).
MAX_DEVICES=2

# Safety cap on photo analyses per user per 24 hours (controls API cost).
DAILY_ANALYSIS_LIMIT=40

# Model used for recognition.
ANTHROPIC_MODEL=claude-opus-5-5

PORT=3000
DB_PATH=data/nutrition.db

# Set to 1 to use fake AI results (for testing the UI without an API key).
MOCK_AI=0
